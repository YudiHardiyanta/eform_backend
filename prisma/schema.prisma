// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  pengawas
  pencacah
  user
}

enum Status {
  open
  draft
  submit
  reject
  approve
}

enum moda {
  cawi
  capi
}

enum WilayahKecil {
  prov
  kab
  kec
  desa
  sls
  subsls
  bs
}

model MProv {
  id             Int              @id @default(autoincrement())
  kode           String
  nama           String
  versi          String?
  Kab            MKab[]
  MKec           MKec[]
  MDesa          MDesa[]
  SampelKegiatan SampelKegiatan[]
  MSLS           MSLS[]

  @@unique([kode, versi])
  @@map("m_prov")
}

model MKab {
  id             Int              @id @default(autoincrement())
  kode           String
  nama           String
  kode_prov      String
  versi          String?
  MProv          MProv?           @relation(fields: [kode_prov, versi], references: [kode, versi])
  MKec           MKec[]
  MDesa          MDesa[]
  SampelKegiatan SampelKegiatan[]
  MSLS           MSLS[]

  @@unique([kode, versi])
  @@map("m_kab")
}

model MKec {
  id             Int              @id @default(autoincrement())
  kode           String
  nama           String
  kode_prov      String
  kode_kab       String
  versi          String?
  MProv          MProv?           @relation(fields: [kode_prov, versi], references: [kode, versi])
  MKab           MKab?            @relation(fields: [kode_kab, versi], references: [kode, versi])
  MDesa          MDesa[]
  SampelKegiatan SampelKegiatan[]
  MSLS           MSLS[]

  @@unique([kode, versi])
  @@map("m_kec")
}

model MDesa {
  id             Int              @id @default(autoincrement())
  kode           String
  nama           String
  kode_prov      String
  kode_kab       String
  kode_kec       String
  versi          String?
  SampelKegiatan SampelKegiatan[]

  MProv MProv? @relation(fields: [kode_prov, versi], references: [kode, versi])
  MKab  MKab?  @relation(fields: [kode_kab, versi], references: [kode, versi])
  MKec  MKec?  @relation(fields: [kode_kec, versi], references: [kode, versi])
  MSLS  MSLS[]

  @@unique([kode, versi])
  @@map("m_desa")
}

model MSLS {
  id             Int              @id @default(autoincrement())
  kode           String
  nama           String
  kode_prov      String
  kode_kab       String
  kode_kec       String
  kode_desa      String
  versi          String?
  SampelKegiatan SampelKegiatan[]

  MProv MProv? @relation(fields: [kode_prov, versi], references: [kode, versi])
  MKab  MKab?  @relation(fields: [kode_kab, versi], references: [kode, versi])
  MKec  MKec?  @relation(fields: [kode_kec, versi], references: [kode, versi])
  MDesa MDesa? @relation(fields: [kode_desa, versi], references: [kode, versi])

  @@unique([kode, versi])
  @@map("m_sls")
}

model User {
  id        Int        @id @default(autoincrement())
  nama      String
  email     String     @unique
  password  String
  userRoles UserRole[]
  satker    String?
  lastLogin DateTime?
  role      Role       @default(user)

  @@map("tb_users")
}

model Kegiatan {
  id               Int          @id @default(autoincrement())
  nama             String
  deskripsi        String
  pencacah_edit    Boolean      @default(true)
  pengawas_edit    Boolean      @default(false)
  pengawas_approve Boolean      @default(true)
  wilayah_kecil    WilayahKecil @default(subsls)
  table_header     Json?
  table_var        Json?
  tgl_mulai        DateTime
  tgl_selesai      DateTime
  path             String?
  path_cawi        String?
  color            String?
  userRoles        UserRole[]

  @@map("tb_kegiatan")
}

model UserRole {
  id          Int       @id @default(autoincrement())
  user_email  String
  role        Role      @default(pencacah)
  kegiatan_id Int
  User        User?     @relation(fields: [user_email], references: [email])
  Kegiatan    Kegiatan? @relation(fields: [kegiatan_id], references: [id])

  @@map("tb_user_role")
}

model SampelKegiatan {
  id              Int              @id @default(autoincrement())
  prov            String
  kab             String?
  kec             String?
  desa            String?
  sls             String?
  subsls          String?
  bs              String?
  nama            String?
  wilayah_id      String
  kegiatan_id     String
  predifined_data Json?
  pencacah_email  String?
  pengawas_email  String?
  moda_utama      moda?            @default(capi)
  token           String?          @db.Text
  status          Status           @default(open)
  catatan         String?          @db.Text
  answerKegiatan  AnswerKegiatan[]
  versi           String?
  email           String?
  MProv           MProv?           @relation(fields: [prov,versi], references: [kode,versi])
  MKab            MKab?            @relation(fields: [kab,versi], references: [kode,versi])
  MKec            MKec?            @relation(fields: [kec,versi], references: [kode,versi])
  MDesa           MDesa?           @relation(fields: [desa,versi], references: [kode,versi])
  MSLS            MSLS?            @relation(fields: [sls,versi], references: [kode,versi])
  

  @@map("tb_sampel_kegiatan")
}

model AnswerKegiatan {
  id                 Int             @id @default(autoincrement())
  answer             Json?
  sample_kegiatan_id Int
  is_aktif           Boolean         @default(true)
  SampelKegiatan     SampelKegiatan? @relation(fields: [sample_kegiatan_id], references: [id])
  createdAt          DateTime?       @default(now())
  updatedAt          DateTime?       @updatedAt
  createdBy          String?

  @@map("tb_answer")
}

model Notification {
  id          Int     @id @default(autoincrement())
  from        String
  to          String
  message     String
  kegiatan_id Int
  is_open     Boolean @default(false)

  @@map("tb_notif")
}

model ListUsaha {
  id      Int     @id @default(autoincrement())
  nama    String
  email   String
  telepon String?

  @@map("m_list_usaha")
}

model EmailHistory {
  id                 Int       @id @default(autoincrement())
  sample_kegiatan_id Int
  to                 String
  status             Boolean
  createdAt          DateTime? @default(now())
  updatedAt          DateTime? @updatedAt

  @@map("t_email_history")
}

model EmailFormat {
  id          Int     @id @default(autoincrement())
  kegiatan_id Int
  body_html   String? @db.Text()
  attachments Json?

  @@map("m_email_format")
}

model KBLI {
  id              Int     @id @default(autoincrement())
  kbli_kode       String
  kbli_kategori   String
  kbli_deskripsi  String
  kbli_keterangan String  @db.Text()
  versi           String?

  @@map("m_kbli")
}
